# Copy to .env for local runs (never commit .env)
MOCK_LLM=0                 # 1 = canned Gemini outputs (trend data is still live)
OFFLINE=0                  # 1 = no network at all; synthetic curves for tests/CI only
GEMINI_MODEL=              # current Flash model ID; `python -m scripts.smoke_gemini` lists what your key can use
GOOGLE_API_KEY=            # AI Studio key (AIza...) or Vertex AI express-mode key (AQ....); auto-detected
GEMINI_AUTH=auto           # auto | ai_studio | vertex_express | vertex_adc
GOOGLE_CLOUD_PROJECT=      # only for vertex_adc
GOOGLE_CLOUD_LOCATION=global
WIKI_USER_AGENT=Trend2Line/0.2 (your-email@example.com)
HTTP_CACHE_HOURS=12
