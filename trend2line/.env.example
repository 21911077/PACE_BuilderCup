# Copy to .env for local runs (never commit .env)
MOCK_LLM=0
GEMINI_MODEL=            # current Flash model ID from AI Studio
GOOGLE_API_KEY=          # AI Studio key; or set USE_VERTEX=1 and use ADC instead
USE_VERTEX=0
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
WIKI_USER_AGENT=Trend2Line/0.1 (your-email@example.com)
